{
  "name": "govdoc-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GovDoc 文档排版合规化 —— 前端（React 19 + TypeScript + Tailwind CSS v4 + HeroUI v3）",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
