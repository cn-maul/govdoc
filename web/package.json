{
  "name": "govdoc-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GovDoc 文档排版合规化 —— 前端（Vue 3 + TypeScript + 手写 CSS，无任何 UI 组件库）",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
