# ---- Go 构建产物 ----
/govdoc
/govdoc.exe
*.exe
*.test
*.out
/dist/

# tools/ 下各命令直接 go build 时会产生同名可执行文件
/httpe2e
/httpe2e.exe
/stublm
/stublm.exe
/e2e
/e2e.exe

# ---- 前端 ----
web/node_modules/
web/.vite/
web/*.tsbuildinfo

# web/dist 是被 go:embed 依赖的构建产物：它必须存在于源码树中才能编译，
# 因此**不忽略**。修改前端后请执行 `cd web && pnpm run build` 并提交结果，
# 否则二进制里会是旧界面。

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- 本地配置（可能含 API Key，绝不入库）----
.env
.env.local
*.local.json
# govdoc.config.json 是 exe 同目录的运行配置，保存了 API Key，只能留在本机。
/govdoc.config.json
# 构建脚本被运行中的 exe 占用时会写出带波浪号的临时产物。
/govdoc.exe~

# ---- e2e 输出 ----
/out/
